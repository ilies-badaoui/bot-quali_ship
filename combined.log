2024-10-08 09:44:21 [info]: Statut de remboursement : async function getRefundStatus(page) {
  let refundStatus = "0";
  let shipmentNumbers = [];

  try {
    // Vérifier si le bouton "Afficher les statuts" est présent
    const hoverSelector =
      "#form2 > div.comment-top > div:nth-child(1) > div > p > span.sm-table-cell.info-text.sm-hidden > span";

    const isHoverVisible = await page.evaluate((selector) => {
      return document.querySelector(selector) !== null;
    }, hoverSelector);

    if (isHoverVisible) {
      logger.info(
        "Le bouton 'Afficher les statuts' est présent, tentative de survol..."
      );

      try {
        // Attendre que le bouton "Afficher les statuts" soit visible
        await page.waitForSelector(hoverSelector, {
          visible: true,
          timeout: 15000,
        });

        // Survoler pour faire apparaître le popup
        await page.hover(hoverSelector);
        await delay(5000); // Attendre que le popup apparaisse

        // Extraire les informations de remboursement et les numéros d'envoi
        const refunds = await page.evaluate(() => {
          return Array.from(
            document.querySelectorAll(
              "#form4 > div.comment-top > div:nth-child(1) > div > p > span.lg-hidden.sm-table-cell"
            )
          ).map((el) => el.textContent.trim());
        });

        // Filtrer les statuts "Validé" et récupérer les numéros d'envoi correspondants
        shipmentNumbers = refunds
          .filter((text) => text.includes("Validé"))
          .map((text) => text.split(":")[0].trim());

        // Si au moins un remboursement est validé, mettre refundStatus à "1"
        refundStatus = shipmentNumbers.length > 0 ? "1" : "0";

        logger.info(
          `Numéros d'envoi récupérés : ${shipmentNumbers.join(", ")}`
        );
        logger.info(`Statut de remboursement : ${refundStatus}`);
      } catch (hoverError) {
        logger.error(
          "Erreur lors du survol pour afficher les statuts : " +
            hoverError.message
        );
      }
    } else {
      logger.info(
        "Le bouton 'Afficher les statuts' n'est pas présent, aucun traitement."
      );
    }
  } catch (error) {
    logger.error(
      "Erreur lors de la récupération du statut de remboursement : " +
        error.message
    );
  }

  return { refundStatus, shipmentNumbers };
}
